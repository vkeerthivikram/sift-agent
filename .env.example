# sift-agent environment examples
# Copy to .env, uncomment the block for your provider, fill in values.
# The agent reads these via os.environ; source the file or use a loader
# (e.g. `set -a; . .env; set +a`) before running `sift`.

# ---------------------------------------------------------------------------
# Provider: openai
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Provider: anthropic
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Provider: azure
# --model (or AZURE_OPENAI_DEPLOYMENT) = deployment name
# ---------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Provider: bedrock
# Standard AWS credential chain: profile OR explicit keys.
# ---------------------------------------------------------------------------
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Provider: openai-compatible (vLLM / Ollama / LM Studio)
# --model required (e.g. qwen2.5:14b, llama3.1:8b)
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=EMPTY

# ---------------------------------------------------------------------------
# Provider: none — offline mode, no LLM calls, no variables needed
# ---------------------------------------------------------------------------
